#################################################################
#  Makefile for vkmmc_optix - OptiX 7 accelerated mesh/shape MC
#
#  make               build ../bin/vkmmc_optix (all kernel variants embedded)
#  make HAVE_ZLIB=yes link the system zlib instead of the bundled miniz
#  make DEBUG=1       debug build; also builds the OptiX module unoptimized
#  make clean         remove build products
#
#  OPTIX_DIR (default /usr/local/optix) must contain include/optix.h and
#  SDK/sutil/vec_math.h; CUDA_DIR defaults to /usr/local/cuda.
#################################################################

CUDA_DIR  ?= /usr/local/cuda
OPTIX_DIR ?= /usr/local/optix
SRC_DIR   := ../src
NVCC      ?= $(CUDA_DIR)/bin/nvcc
CXX       ?= g++
CC        ?= gcc
XXD       ?= xxd

BINDIR    := ../bin
EXEC      := $(BINDIR)/vkmmc_optix

NVCC_FLAGS    := -ptx --expt-relaxed-constexpr --use_fast_math -std=c++11
NVCC_INCLUDES := -I$(OPTIX_DIR)/include -I$(OPTIX_DIR)/SDK
CXX_FLAGS     := -std=c++11 -O3 -Wall -Wno-missing-field-initializers
CXX_INCLUDES  := -I$(SRC_DIR) -I$(SRC_DIR)/zmat -I$(OPTIX_DIR)/include -I$(CUDA_DIR)/include
CXX_LIBS      := -L$(CUDA_DIR)/lib64 -lcudart -ldl -lpthread

ifdef DEBUG
    CXX_FLAGS += -g -O0 -DVKMMC_OPTIX_DEBUG
endif

# zmat (shared with ../src)
ZMATFLAGS := -O3 -DNO_LZMA -DNO_LZ4 -DNO_BLOSC2 -DNO_ZSTD -I$(SRC_DIR)/zmat
ZMATOBJS  := zmat.o
ifeq ($(HAVE_ZLIB),yes)
    CXX_LIBS  += -lz
else
    ZMATFLAGS += -DNO_ZLIB -I$(SRC_DIR)/zmat/miniz
    ZMATOBJS  += miniz.o
endif

# kernel variants
VARIANT_mesh :=
VARIANT_csg  := -DUSE_CSG
VARIANT_curv := -DUSE_CSG -DUSE_CURVATURE
PTXS         := vkmmc_optix_mesh.ptx vkmmc_optix_csg.ptx vkmmc_optix_curv.ptx
PTX_HEADER   := vkmmc_optix_ptx.h

HEADERS := $(SRC_DIR)/vkmmc_io.h $(SRC_DIR)/vkmmc_host.h $(SRC_DIR)/vkmmc_shapes.h $(SRC_DIR)/vkmmc_curvature.h

.PHONY: all clean pretty

all: $(EXEC)

vkmmc_optix_%.ptx: vkmmc_optix_core.cu
	$(NVCC) $(NVCC_FLAGS) $(NVCC_INCLUDES) $(VARIANT_$*) -o $@ $<

# embed the PTX as NUL-terminated strings
$(PTX_HEADER): $(PTXS)
	@echo "/* generated by the Makefile from vkmmc_optix_core.cu, do not edit */" > $@
	@for f in $(PTXS); do $(XXD) -i $$f | sed 's/^unsigned char/static const unsigned char/; s/^unsigned int/static const unsigned int/' >> $@; done
	@echo "Built: $@"

zmat.o: $(SRC_DIR)/zmat/zmatlib.c
	$(CC) $(ZMATFLAGS) -c -o $@ $<

miniz.o: $(SRC_DIR)/zmat/miniz/miniz.c
	$(CC) -O3 -c -o $@ $<

$(EXEC): vkmmc_optix.cpp $(PTX_HEADER) $(HEADERS) $(ZMATOBJS)
	@mkdir -p $(BINDIR)
	$(CXX) $(CXX_FLAGS) $(CXX_INCLUDES) -o $@ vkmmc_optix.cpp $(ZMATOBJS) $(CXX_LIBS)
	@echo "Built: $@"

clean:
	rm -f $(EXEC) $(PTXS) $(PTX_HEADER) $(ZMATOBJS) vkmmc_optix_core.ptx vkmmc_optix *.jdat

pretty:
	astyle \
	    --style=attach \
	    --indent=spaces=4 \
	    --indent-modifiers \
	    --indent-switches \
	    --indent-preproc-block \
	    --indent-preproc-define \
	    --indent-col1-comments \
	    --pad-oper \
	    --pad-header \
	    --align-pointer=type \
	    --align-reference=type \
	    --add-brackets \
	    --convert-tabs \
	    --lineend=linux \
	    --preserve-date \
	    --suffix=none \
	    --formatted \
	    --break-blocks \
	   "*.cpp" "*.cu"
