# embed_files.cmake — write binary files into a C header, like "xxd -i"
#
#   cmake -DOUTPUT=out.h -DINPUTS="a.spv;b.spv" [-DQUALIFIER="static const"]
#         [-DALIGN=1] -P embed_files.cmake
#
# Each input becomes "<qualifier> unsigned char <name>[] = {...};" and
# "<qualifier> unsigned int <name>_len = N;", where <name> is the file name
# with every character other than [A-Za-z0-9] replaced by '_' (as xxd does).
# ALIGN=1 adds alignas(4), needed to pass SPIR-V as uint32_t words.

if(NOT DEFINED OUTPUT OR NOT DEFINED INPUTS)
    message(FATAL_ERROR "embed_files.cmake needs -DOUTPUT=... and -DINPUTS=...")
endif()

if(NOT DEFINED QUALIFIER)
    set(QUALIFIER "")
endif()

set(prefix "")

if(ALIGN)
    set(prefix "alignas(4) ")
endif()

set(text "/* generated by cmake/embed_files.cmake, do not edit */\n")

foreach(f IN LISTS INPUTS)
    get_filename_component(base "${f}" NAME)
    string(MAKE_C_IDENTIFIER "${base}" name)
    file(READ "${f}" hex HEX)
    string(LENGTH "${hex}" nhex)
    math(EXPR nbytes "${nhex} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # 16 bytes per line
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n  " bytes "${bytes}")
    string(APPEND text "${prefix}${QUALIFIER} unsigned char ${name}[] = {\n  ${bytes}\n};\n")
    string(APPEND text "${QUALIFIER} unsigned int ${name}_len = ${nbytes};\n")
endforeach()

# rewrite only on change, so dependents are not rebuilt needlessly
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)

    if(old STREQUAL text)
        return()
    endif()
endif()

file(WRITE "${OUTPUT}" "${text}")
