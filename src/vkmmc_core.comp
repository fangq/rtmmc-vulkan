/*
 * vkmmc_core.comp — Monte Carlo photon transport via Vulkan ray query
 *
 * Supports two modes:
 *   1. Mesh mode (do_csg=0): front/back media labels per triangle (tetrahedral mesh)
 *   2. CSG mode  (do_csg=1): shape-based, each triangle stores only back-material (Tag).
 *      A per-photon 8-byte state buffer tracks enclosing surfaces.
 *      Highest media ID among all enclosing surfaces determines the current medium.
 *
 * Curvature-informed reflection: when has_curvature=1, uses per-node principal
 * curvature to estimate the true surface normal at the intersection point.
 *
 * Compile-time flags (passed via -D to glslangValidator):
 *   USE_CSG         — enable CSG shape-based media state tracking
 *   USE_CURVATURE   — enable curvature-corrected normals (requires USE_CSG)
 *   USE_ATOMIC_INT64 — native 64-bit integer atomics (GL_EXT_shader_atomic_int64);
 *                      without it the 64-bit sums use pairs of 32-bit atomics
 * The Makefile builds all six combinations and embeds them in vkmmc; the host
 * picks one per input and device.
 *
 * Optimizations for curvature mode:
 *   - Main ray trace uses trace_ray (no barycentrics) always
 *   - Barycentrics only fetched via a second trace when curvature normal is needed
 *   - Curvature normal computed by accumulating per-vertex contributions sequentially
 *     to reduce register pressure (no 3x simultaneous vec4 loads)
 *   - Single get_normal() used everywhere (no inlined duplication)
 *
 * Build example (a kernel passed as the last vkmmc argument overrides the embedded one):
 *   glslangValidator --target-env vulkan1.2 -e main -DUSE_CSG -DUSE_CURVATURE -o my.spv vkmmc_core.comp
 */
#version 460
#extension GL_EXT_ray_query : require

#ifdef USE_ATOMIC_INT64
    #extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
    #extension GL_EXT_shader_atomic_int64 : require
#endif

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;

layout(std430, set = 0, binding = 1) readonly buffer FaceBuffer {
    vec4 face_normal[];
};

struct Medium {
    float mua, mus, g, n;
};
layout(std430, set = 0, binding = 2) readonly buffer MediaBuffer { Medium media[]; };

// output: one unsigned 64-bit fixed-point sum (FIXED_SCALE units) per element
#ifdef USE_ATOMIC_INT64
layout(std430, set = 0, binding = 3) buffer OutputBuffer { uint64_t output_data[]; };
#else
layout(std430, set = 0, binding = 3) buffer OutputBuffer { uint output_data[]; };
#endif

// MCParams / SimParams layout — must match C++ struct exactly
// std140 rules: vec4 aligned to 16 bytes, scalars packed in groups of 4
//
// offset  0: srcpos[4]         vec4
// offset 16: srcdir[4]         vec4
// offset 32: srcparam1[4]      vec4
// offset 48: srcparam2[4]      vec4
// offset 64: nmin[4]           vec4  (grid_min)
// offset 80: nmax[4]           vec4  (grid_extent)
// offset 96: crop0[4]          uvec4 (grid_stride)
//
// offset 112: dstep, tstart, tend, Rtstep          4 floats
// offset 128: srctype, maxgate, outputtype, isreflect   3 ints + 1 uint
// offset 144: mediumid0, total_threads, num_media, seed  4 uints
// offset 160: do_csg, has_curvature, threadphoton, oddphoton  2 uint + 2 int
// offset 176: minenergy, roulettesize, do_traj, max_traj    2 floats + 2 uints
// offset 192: photon_base                                   1 uint

layout(std140, set = 0, binding = 4) uniform SimParams {
    vec4  src_pos;           // offset 0
    vec4  src_dir;           // offset 16
    vec4  src_param1;        // offset 32
    vec4  src_param2;        // offset 48
    vec4  grid_min;          // offset 64
    vec4  grid_extent;       // offset 80
    uvec4 grid_stride;       // offset 96

    // offset 112: scalar row 0
    float voxel_scale;       // 112
    float time_start;        // 116
    float time_end;          // 120
    float inv_timestep;      // 124

    // offset 128: scalar row 1
    int   src_type;          // 128
    int   max_gate;          // 132
    int   output_type;       // 136
    uint  do_reflect;        // 140

    // offset 144: scalar row 2
    uint  initial_medium;    // 144
    uint  total_threads;     // 148
    uint  num_media;         // 152
    uint  rng_seed;          // 156

    // offset 160: scalar row 3
    uint  do_csg;            // 160
    uint  has_curvature;     // 164
    int   photons_per_thread;// 168
    int   extra_photons;     // 172

    // offset 176: scalar row 4
    float minenergy;         // 176
    float roulettesize;      // 180
    uint  do_traj;           // 184
    uint  max_traj;          // 188

    // offset 192: scalar row 5
    uint  photon_base;       // 192 — global photon index offset for this batch
};

layout(std430, set = 0, binding = 5) readonly buffer SeedBuffer { uvec4 thread_seeds[]; };

struct NodeCurv {
    vec4 vnorm_k1;   // .xyz = vertex normal, .w = k1
    vec4 pdir_k2;    // .xyz = principal direction 1, .w = k2
    vec4 node_pos;   // .xyz = node world position
};
layout(std430, set = 0, binding = 6) readonly buffer CurvBuffer { NodeCurv node_curv[]; };
layout(std430, set = 0, binding = 7) buffer TrajBuffer { uint traj_data[]; };

// ==================== Constants ====================

const float INV_C0       = 3.335640951981520e-12;  // 1/C0 in s/mm
const float SAFETY_DIST  = 0.001;       // heuristic to ensure ray crosses triangle
const float TWO_PI       = 6.28318530717959;       // 2*pi
const float FEPS         = 1.19209290E-07;         // float epsilon / round-off limit
const float FMAX         = 3.402823466e+38;        // float max
const float RAY_TMIN     = 1e-5;                   // minimum ray distance

const uint MEDIUM_UNKNOWN = 0xFFFFFFFFu;
const uint MEDIUM_DEAD    = 0xFFFFFFFEu;
const uint MEDIUM_AMBIENT = 0u;
const uint MEDIUM_BBOX    = 0xFFFFu;   // bounding box termination label
const int  OUT_FLUX = 0, OUT_FLUENCE = 1, OUT_ENERGY = 2;

#ifdef USE_CURVATURE
    const uint FLAT_FLAG = 0x80000000u;    // bit 31 marks geometrically flat triangles
#endif

// ==================== RNG (xorshift128+) ====================

float rand01(inout uvec4 st) {
    uvec2 s1 = st.xy, s0 = st.zw;
    st.xy = s0;
    s1 ^= uvec2(s1.x << 23u, (s1.y << 23u) | (s1.x >> 9u));
    uvec2 ns = s1 ^ s0 ^ uvec2((s1.x >> 18u) | (s1.y << 14u), s1.y >> 18u)
               ^ uvec2((s0.x >> 5u) | (s0.y << 27u), s0.y >> 5u);
    st.zw = ns;
    return uintBitsToFloat(0x3F800000u | ((ns.x + s0.x) >> 9u)) - 1.0;
}

float rand_range(inout uvec4 s, float a, float b) {
    return (b - a) * rand01(s) + a;
}

float rand_scatlen(inout uvec4 s) {
    return -log(rand01(s) + FEPS);
}

// ==================== Ray Tracing ====================

/**
 * Trace a ray against the acceleration structure.
 * Returns true if a triangle is hit, with distance, triangle ID, and face orientation.
 */
bool trace_ray(vec3 o, vec3 d, float tmin, float tmax,
               out float dist, out int tri_id, out bool front_face) {
    rayQueryEXT q;
    rayQueryInitializeEXT(q, scene, gl_RayFlagsNoneEXT, 0xFF, o, tmin, d, tmax);

    while (rayQueryProceedEXT(q)) {}

    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        dist = rayQueryGetIntersectionTEXT(q, true);
        tri_id = rayQueryGetIntersectionPrimitiveIndexEXT(q, true);
        front_face = rayQueryGetIntersectionFrontFaceEXT(q, true);
        return true;
    }

    return false;
}

/**
 * Unpack front and back media IDs from packed float.
 * Bit 31 = flat flag, bit 30 = coplanar flag, [29:16] = front, [15:0] = back.
 */
void unpack_media(float pw, out uint front_med, out uint back_med) {
    uint p = floatBitsToUint(pw);
    front_med = (p >> 16u) & 0x3FFFu;
    back_med  = p & 0xFFFFu;
}

/* the triangle overlaps a coplanar triangle of another CSG surface */
bool is_coplanar_triangle(float pw) {
    return (floatBitsToUint(pw) & 0x40000000u) != 0u;
}

#ifdef USE_CURVATURE
/**
 * Check if a triangle is flat-flagged (bit 31 of packed_media).
 * Flat triangles skip curvature correction and use the face normal directly.
 */
bool is_flat_triangle(float pw) {
    return (floatBitsToUint(pw) & FLAT_FLAG) != 0u;
}
#endif

// ==================== Media State Buffer (CSG mode) ====================
//
// In CSG mode, each photon carries an 8-byte (uvec2) state that tracks
// which shapes the photon is currently inside. The highest-priority
// (highest Tag value) shape determines the current medium.

#ifdef USE_CSG
uint ms_get(uvec2 ms, int slot) {
    uint word = (slot < 4) ? ms.x : ms.y;
    return (word >> (uint(slot & 3) * 8u)) & 0xFFu;
}

uvec2 ms_set(uvec2 ms, int slot, uint val) {
    uint shift = uint(slot & 3) * 8u;
    uint mask = 0xFFu << shift;

    if (slot < 4) {
        ms.x = (ms.x & ~mask) | ((val & 0xFFu) << shift);
    } else {
        ms.y = (ms.y & ~mask) | ((val & 0xFFu) << shift);
    }

    return ms;
}

/**
 * Enter a shape: add its media ID to the state buffer.
 * The highest ID becomes the active medium (slot 0).
 */
uvec2 ms_enter(uvec2 ms, uint back_id) {
    if (back_id == 0u) {
        return ms;
    }

    uint cur = ms_get(ms, 0);
    uint mx = max(cur, back_id), dem = (mx == back_id) ? cur : back_id;
    ms = ms_set(ms, 0, mx);

    if (dem > 0u)
        for (int i = 1; i < 8; i++)
            if (ms_get(ms, i) == 0u) {
                ms = ms_set(ms, i, dem);
                break;
            }

    return ms;
}

/**
 * Leave a shape: remove its media ID from the state buffer.
 * Recalculate the highest remaining ID as the active medium.
 */
uvec2 ms_leave(uvec2 ms, uint back_id) {
    if (back_id == 0u) {
        return ms;
    }

    for (int i = 0; i < 8; i++)
        if (ms_get(ms, i) == back_id) {
            ms = ms_set(ms, i, 0u);
            break;
        }

    uint mx = 0u;
    int ms2 = -1;

    for (int i = 0; i < 8; i++) {
        uint v = ms_get(ms, i);

        if (v > mx) {
            mx = v;
            ms2 = i;
        }
    }

    if (ms2 > 0) {
        ms = ms_set(ms, ms2, 0u);
        ms = ms_set(ms, 0, mx);
    } else if (ms2 < 0) {
        ms = ms_set(ms, 0, 0u);
    }

    return ms;
}
#endif

// ==================== Output ====================

/**
 * Add a deposit to output element idx. Sums are kept as unsigned 64-bit
 * fixed-point numbers (FIXED_SCALE = 2^32 units per photon weight): integer
 * sums are exact and independent of the order of the additions, so a run is
 * bit-reproducible and its precision does not degrade with the photon count,
 * unlike float atomics. Without native 64-bit atomics the sum is a (low, high)
 * pair of 32-bit words with an explicit carry; both layouts are identical in
 * memory.
 */
const float FIXED_SCALE = 4294967296.0;

void atomic_add_float(uint idx, float val) {
    float v = val * FIXED_SCALE + 0.5;   // round to nearest
#ifdef USE_ATOMIC_INT64
    atomicAdd(output_data[idx], uint64_t(v));
#else
    uint hi = uint(v * (1.0 / FIXED_SCALE));
    uint lo = uint(v - float(hi) * FIXED_SCALE);
    uint old = atomicAdd(output_data[2u * idx], lo);

    if (old + lo < old) {
        hi++;               // carry out of the low word
    }

    if (hi != 0u) {
        atomicAdd(output_data[2u * idx + 1u], hi);
    }

#endif
}

/**
 * Accumulate output along a path of length L from p in direction d.
 *
 * The path is traversed voxel by voxel (3-D DDA) and split at time-gate
 * boundaries, so every piece deposits into the voxel and gate it lies in.
 * A piece of length l carrying weight w deposits
 *   energy:        w (1 - exp(-mua l))
 *   fluence/flux:  w (1 - exp(-mua l)) / mua   (-> w l when mua -> 0)
 * Deposits outside [time_start, time_end) are dropped.
 */
void accumulate(vec3 p, vec3 d, uint mid, float w, float tof, float L) {
    if (!(L > 0.0)) {
        return;
    }

    Medium pr = media[mid];
    ivec3 dim = ivec3(int(grid_stride.x), int(grid_stride.y / grid_stride.x), int(grid_stride.z / grid_stride.y));
    vec3 s = (p - grid_min.xyz) * voxel_scale;          // start in voxel coordinates
    float Lv = L * voxel_scale;                          // length in voxels
    float lscale = 1.0 / voxel_scale;                    // voxel length in length units
    ivec3 iv = clamp(ivec3(floor(s)), ivec3(0), dim - 1);
    float g0 = (tof - time_start) * inv_timestep;        // gate coordinate at the start
    float gstep = INV_C0 * pr.n * lscale * inv_timestep; // gate coordinate per voxel length
    float gi = floor(g0);                                // current gate, advanced incrementally

    // fast path: a step that starts and ends in the same voxel and gate
    if (iv == clamp(ivec3(floor(s + d * Lv)), ivec3(0), dim - 1) && floor(g0 + Lv * gstep) == gi) {
        if (gi >= 0.0 && gi < float(max_gate)) {
            float x = pr.mua * L;
            float frac = (x < 1e-3) ? x * (1.0 - 0.5 * x) : 1.0 - exp(-x);
            atomic_add_float(uint(gi) * grid_stride.z + uint(iv.z) * grid_stride.y + uint(iv.y) * grid_stride.x + uint(iv.x),
                             (output_type == OUT_ENERGY) ? w * frac : w * ((x < 1e-3) ? L * (1.0 - 0.5 * x) : frac / pr.mua));
        }

        return;
    }

    vec3 ad = abs(d), tdel = 1.0 / max(ad, vec3(1e-20));
    vec3 tm;
    tm.x = (ad.x < 1e-20) ? FMAX : max(((d.x > 0.0) ? float(iv.x + 1) - s.x : s.x - float(iv.x)) * tdel.x, 0.0);
    tm.y = (ad.y < 1e-20) ? FMAX : max(((d.y > 0.0) ? float(iv.y + 1) - s.y : s.y - float(iv.y)) * tdel.y, 0.0);
    tm.z = (ad.z < 1e-20) ? FMAX : max(((d.z > 0.0) ? float(iv.z + 1) - s.z : s.z - float(iv.z)) * tdel.z, 0.0);
    ivec3 dir = ivec3(d.x > 0.0 ? 1 : -1, d.y > 0.0 ? 1 : -1, d.z > 0.0 ? 1 : -1);

    float tg = (gi + 1.0 - g0) / gstep;                  // distance to the next gate boundary
    float t = 0.0;

    for (int guard = 0; guard < 65536 && t < Lv; guard++) {
        if (gi >= float(max_gate)) {
            break;          // later pieces are later in time
        }

        float tv = min(min(tm.x, tm.y), tm.z);
        float te = min(min(tv, tg), Lv);
        float x = pr.mua * (te - t) * lscale;
        float frac = (x < 1e-3) ? x * (1.0 - 0.5 * x) : 1.0 - exp(-x);

        if (gi >= 0.0) {
            float dep = (output_type == OUT_ENERGY) ? w * frac
                        : w * ((x < 1e-3) ? (te - t) * lscale * (1.0 - 0.5 * x) : frac / pr.mua);
            atomic_add_float(uint(gi) * grid_stride.z + uint(iv.z) * grid_stride.y + uint(iv.y) * grid_stride.x + uint(iv.x), dep);
        }

        w *= 1.0 - frac;
        t = te;

        if (te == tg) {
            gi += 1.0;
            tg = (gi + 1.0 - g0) / gstep;
        }

        if (te == tv && te < Lv) {
            // step into the next voxel along the axis whose boundary was reached
            if (tm.x <= tm.y && tm.x <= tm.z) {
                iv.x = clamp(iv.x + dir.x, 0, dim.x - 1);
                tm.x += tdel.x;
            } else if (tm.y <= tm.z) {
                iv.y = clamp(iv.y + dir.y, 0, dim.y - 1);
                tm.y += tdel.y;
            } else {
                iv.z = clamp(iv.z + dir.z, 0, dim.z - 1);
                tm.z += tdel.z;
            }
        }
    }
}

// ==================== Scattering ====================

/**
 * Rotate a vector with given azimuth and zenith angles.
 */
vec3 rotate_dir(vec3 v, vec2 z, vec2 a) {
    if (v.z > -1.0 + FEPS && v.z < 1.0 - FEPS) {
        float s2 = 1.0 - v.z * v.z, sc = z.x * inversesqrt(s2);
        return sc * (a.y * vec3(v.x * v.z, v.y * v.z, -s2) + a.x * vec3(-v.y, v.x, 0.0)) + z.y * v;
    }

    return vec3(z.x * a.y, z.x * a.x, v.z > 0.0 ? z.y : -z.y);
}

/**
 * Update ray direction after a scattering event.
 * Uses Henyey-Greenstein phase function.
 */
vec3 scatter_dir(vec3 d, float g, inout uvec4 rng) {
    float ct;

    if (abs(g) > FEPS) {
        float t = (1.0 - g * g) / max(1.0 - g + 2.0 * g * rand01(rng), FEPS);
        ct = clamp((1.0 + g * g - t * t) / (2.0 * g), -1.0, 1.0);
    } else {
        ct = 2.0 * rand01(rng) - 1.0;
    }

    float phi = rand_range(rng, 0.0, TWO_PI);
    return rotate_dir(d, vec2(sqrt(max(1.0 - ct * ct, 0.0)), ct), vec2(sin(phi), cos(phi)));
}

// ==================== Fresnel Reflection/Refraction ====================

/**
 * Reflect or refract a ray at a mismatched boundary.
 * N is the shading normal (curvature corrected or flat), Ng the geometric
 * normal of the hit triangle; either orientation is accepted. A direction
 * computed from a smooth N that would not leave the facet on the correct
 * side (reflection back through it, refraction staying on the incoming side)
 * is recomputed from Ng, and the photon is placed SAFETY_DIST off the facet
 * plane on its new side, so the next ray cannot tunnel through the facet.
 * Returns true if reflected, false if transmitted.
 */
bool do_reflection(vec3 N, vec3 Ng, float n1, float n2, inout uvec4 rng, vec3 hit, inout vec3 p, inout vec3 d) {
    vec3 d0 = d;
    vec3 Nin = (dot(d0, Ng) < 0.0) ? Ng : -Ng;   // facet normal on the incoming side
    float ci = -dot(d0, N);

    if (ci < 0.0) {
        N = -N;
        ci = -ci;
    }

    float n12 = n1 * n1, n22 = n2 * n2;
    float ct2 = 1.0 - n12 / n22 * (1.0 - ci * ci);
    bool reflect = true;

    if (ct2 > 0.0) {
        // if no total internal reflection
        float ct = sqrt(ct2);
        float re = n12 * ci * ci + n22 * ct2, im = 2.0 * n1 * n2 * ci * ct;
        float rp = (re - im) / (re + im);       // Rp
        re = n22 * ci * ci + n12 * ct * ct;
        float rt = (rp + (re - im) / (re + im)) * 0.5;  // (Rp+Rs)/2

        if (rand01(rng) > rt) {
            // do transmission
            float ratio = n1 / n2;
            d = ratio * d0 + (ratio * ci - ct) * N;

            if (dot(d, Nin) >= 0.0) {
                // smooth normal sends the photon back: refract about the facet
                float cig = -dot(d0, Nin), ctg2 = 1.0 - ratio * ratio * (1.0 - cig * cig);

                if (ctg2 > 0.0) {
                    d = ratio * d0 + (ratio * cig - sqrt(ctg2)) * Nin;
                } else {
                    d = d0 + 2.0 * cig * Nin;
                    p = hit + Nin * SAFETY_DIST;
                    d *= inversesqrt(dot(d, d));
                    return true;
                }
            }

            p = hit - Nin * SAFETY_DIST;
            reflect = false;
        }
    }

    if (reflect) {
        d = d0 + 2.0 * ci * N;

        if (dot(d, Nin) <= 0.0) {
            // smooth normal sends the photon through the facet: reflect about the facet
            d = d0 - 2.0 * dot(d0, Nin) * Nin;
        }

        p = hit + Nin * SAFETY_DIST;
    }

    // normalize new direction
    d *= inversesqrt(dot(d, d));
    return reflect;
}

// ==================== Curvature Normal ====================
//
// Accumulates per-vertex curvature contributions sequentially
// to minimize register pressure. Only reads 2 vec4s per vertex
// (vnorm_k1 and pdir_k2), plus node_pos.
//
// For each vertex of the hit triangle:
//   N_corrected += N_vertex + k1 * dot(d, u1) * u1 + k2 * dot(d, u2) * u2
// where d = hit_pos - vertex_pos, u1 = principal direction, u2 = cross(u1, N)

#ifdef USE_CURVATURE
vec3 get_curvature_normal_at(int tri_id, vec3 hit_pos) {
    // Skip curvature for flat-flagged triangles (box faces, cylinder caps)
    if (has_curvature == 0u || is_flat_triangle(face_normal[tri_id * 2].w)) {
        return face_normal[tri_id * 2].xyz;
    }

    // face_normal[tri_id*2+1] stores vertex indices as floatBitsToUint
    vec4 vidx_raw = face_normal[tri_id * 2 + 1];
    vec3 NB = vec3(0.0);

    for (int vi = 0; vi < 3; vi++) {
        uint idx = floatBitsToUint(vidx_raw[vi]);
        vec4 nk = node_curv[idx].vnorm_k1;   // .xyz = normal, .w = k1
        vec4 pk = node_curv[idx].pdir_k2;     // .xyz = principal dir, .w = k2
        vec3 di = hit_pos - node_curv[idx].node_pos.xyz;
        vec3 vi2 = cross(pk.xyz, nk.xyz);     // second principal direction

        // Curvature correction: add displacement-scaled curvature terms
        NB += nk.xyz + nk.w * dot(di, pk.xyz) * pk.xyz
              + pk.w * dot(di, vi2) * vi2;
    }

    NB = normalize(NB);

    // Ensure consistent orientation with face normal
    if (dot(NB, face_normal[tri_id * 2].xyz) < 0.0) {
        NB = -NB;
    }

    return NB;
}
#endif

// ==================== Surface Normal Helper ====================
//
// Returns the outward-pointing surface normal at a hit point.
// With USE_CURVATURE: uses curvature-corrected normal for curved triangles.
// Without: uses the precomputed flat face normal.

vec3 get_normal(int tri_id, vec3 hit_pos) {
#ifdef USE_CURVATURE
    return get_curvature_normal_at(tri_id, hit_pos);
#else
    return face_normal[tri_id * 2].xyz;
#endif
}

#ifdef USE_CSG
const float COPLANAR_EPS = 2e-4;    // half width of the window around a facet plane

/* tag bit sets for tags 1..64 */
bool tagset_has(uvec2 set, uint tag) {
    return (((tag > 32u) ? set.y : set.x) & (1u << ((tag - 1u) & 31u))) != 0u;
}

uvec2 tagset_add(uvec2 set, uint tag) {
    uint bit = 1u << ((tag - 1u) & 31u);
    return (tag > 32u) ? uvec2(set.x, set.y | bit) : uvec2(set.x | bit, set.y);
}

/**
 * All CSG triangles at the point where a photon moving along nfar crossed a
 * coplanar-flagged facet: cast a probe back from p (SAFETY_DIST past the
 * facet) along -nfar and enumerate, without committing, every triangle within
 * COPLANAR_EPS of the plane. A ray tracer reports only one of several
 * coincident triangles; this recovers all of them.
 * Mode 0 updates the media state ms (enter/leave each tag once per direction);
 * mode 1 updates the enclosure walk sets seen/inside (first crossing per tag).
 */
void coplanar_crossings(vec3 p, vec3 nfar, int mode, inout uvec2 ms, inout uvec2 seen, inout uvec2 inside) {
    rayQueryEXT q;
    uvec2 entered = uvec2(0u, 0u), left = uvec2(0u, 0u);
    rayQueryInitializeEXT(q, scene, gl_RayFlagsNoOpaqueEXT, 0xFF, p, SAFETY_DIST - COPLANAR_EPS, -nfar,
                          SAFETY_DIST + COPLANAR_EPS);

    while (rayQueryProceedEXT(q)) {
        if (rayQueryGetIntersectionTypeEXT(q, false) != gl_RayQueryCandidateIntersectionTriangleEXT) {
            continue;
        }

        int tid = rayQueryGetIntersectionPrimitiveIndexEXT(q, false);
        // the probe runs against the photon, so it sees the faces from the other side
        bool enter = !rayQueryGetIntersectionFrontFaceEXT(q, false);
        uint fm, bm;
        unpack_media(face_normal[tid * 2].w, fm, bm);

        if (bm < 1u || bm > 64u) {
            continue;
        }

        if (mode == 0) {
            if (enter && !tagset_has(entered, bm)) {
                entered = tagset_add(entered, bm);
                ms = ms_enter(ms, bm);
            } else if (!enter && !tagset_has(left, bm)) {
                left = tagset_add(left, bm);
                ms = ms_leave(ms, bm);
            }
        } else if (!tagset_has(seen, bm)) {
            seen = tagset_add(seen, bm);

            if (!enter) {
                inside = tagset_add(inside, bm);
            }
        }
    }
}

/**
 * Enclosure walk: cast a ray forward through all surfaces and return the set
 * of tags (bit t-1 for tag t, tags 1..64) of the shapes enclosing p. The point
 * is inside a shape exactly when the first crossing of that shape's tag along
 * the ray is an exit (back-face hit); overlapping shapes of the same tag are
 * thus counted once. The start point is perturbed perpendicular to d to avoid
 * degenerate ray-edge/vertex hits.
 */
uvec2 csg_enclosure(vec3 p, vec3 d) {
    uvec2 seen = uvec2(0u, 0u), inside = uvec2(0u, 0u), ms = uvec2(0u, 0u);
    vec3 perp = (abs(d.z) < 0.999) ? normalize(cross(d, vec3(0.0, 0.0, 1.0)))
                : normalize(cross(d, vec3(1.0, 0.0, 0.0)));
    vec3 wp = p + perp * 2e-4;

    for (int wk = 0; wk < 64; wk++) {
        float hd;
        int tid;
        bool ff;

        if (!trace_ray(wp, d, RAY_TMIN, FMAX, hd, tid, ff)) {
            break;
        }

        vec4 fn = face_normal[tid * 2];
        vec3 nfar = (dot(d, fn.xyz) > 0.0) ? fn.xyz : -fn.xyz;
        vec3 hit = wp + d * hd;
        wp = hit + nfar * SAFETY_DIST;

        if (is_coplanar_triangle(fn.w)) {
            coplanar_crossings(wp, nfar, 1, ms, seen, inside);
        } else {
            uint fm, bm;
            unpack_media(fn.w, fm, bm);

            if (bm >= 1u && bm <= 64u && !tagset_has(seen, bm)) {
                seen = tagset_add(seen, bm);

                if (!ff) {
                    inside = tagset_add(inside, bm);
                }
            }
        }
    }

    return inside;
}

/* media state buffer holding the tags of an enclosure set */
uvec2 csg_state(uvec2 inside) {
    uvec2 ms = uvec2(0u, 0u);

    for (uint t = 1u; t <= 64u; t++)
        if (tagset_has(inside, t)) {
            ms = ms_enter(ms, t);
        }

    return ms;
}
#endif

// ==================== Photon Launch ====================

/**
 * Launch a new photon from the source.
 * Determines the initial medium by either:
 *   - CSG parity walk (counting boundary crossings to determine enclosure)
 *   - Mesh mode (single ray probe to find enclosing element)
 */
void launch_photon(inout vec3 p, inout vec3 d, inout float w, inout float slen,
                   inout float tof, inout uint mid, inout uvec2 mstate, inout uvec4 rng,
                   out vec3 launch_pos, inout uvec2 csg_cache, inout bool csg_cached) {
    p = src_pos.xyz;
    d = src_dir.xyz;
    w = 1.0;
    tof = 0.0;
    mstate = uvec2(0u, 0u);

    // ---- Source type handling ----
    if (src_type == 4) {
        // Planar source: random point on quadrilateral
        p = src_pos.xyz + rand01(rng) * src_param1.xyz + rand01(rng) * src_param2.xyz;
    } else if (src_type == 8) {
        // Disk source: uniform random point on disk
        float r0 = sqrt(rand01(rng)) * src_param1.x, phi = TWO_PI * rand01(rng);
        float cp = cos(phi), sp = sin(phi);
        vec3 sd = src_dir.xyz;

        if (sd.z > -1.0 + FEPS && sd.z < 1.0 - FEPS) {
            float t0 = 1.0 - sd.z * sd.z, t1 = r0 * inversesqrt(t0);
            p.x += t1 * (sd.x * sd.z * cp - sd.y * sp);
            p.y += t1 * (sd.y * sd.z * cp + sd.x * sp);
            p.z -= t1 * t0 * cp;
        } else {
            p.x += r0 * cp;
            p.y += r0 * sp;
        }
    }

    slen = rand_scatlen(rng);
    launch_pos = p;  // capture source position before any medium-entry move

    // ---- Determine initial medium ----

#ifdef USE_CSG

    if (do_csg > 0u) {
        // Enclosure walk: cast a ray forward through all surfaces. The source
        // is inside a shape exactly when the first crossing of that shape's
        // tag along the ray is an exit (back-face hit); overlapping shapes of
        // the same tag are thus counted once. The start point is perturbed
        // perpendicular to d to avoid degenerate ray-edge/vertex hits.
        // A pencil source launches every photon from the same point, so the
        // walk is done once per thread and cached in csg_cache.
        uvec2 inside = csg_cache;

        if (src_type != 0 || !csg_cached) {
            inside = csg_enclosure(p, d);
            csg_cache = inside;
            csg_cached = true;
        }

        mstate = csg_state(inside);
        mid = ms_get(mstate, 0);

        // If the source is outside all shapes, enter the first shape it points at
        if (mid == 0u) {
            float hd;
            int tid;
            bool ff;

            if (trace_ray(p, d, 0.0, FMAX, hd, tid, ff) && ff) {
                uint fm, bm;
                unpack_media(face_normal[tid * 2].w, fm, bm);
                vec3 hp = p + d * hd;
                p = hp + d * SAFETY_DIST;
                mstate = ms_enter(mstate, bm);
                mid = ms_get(mstate, 0);

                // Fresnel reflection at the entry boundary
                if (do_reflect > 0u && mid < num_media && media[0].n != media[mid].n
                        && do_reflection(get_normal(tid, hp), face_normal[tid * 2].xyz, media[0].n, media[mid].n, rng, hp, p, d)) {
                    mstate = uvec2(0u, 0u);
                    mid = MEDIUM_DEAD;
                    w = 0.0;
                }
            } else {
                mid = MEDIUM_DEAD;
            }
        }
    } else
#endif
    {
        // Mesh mode: initial medium is pre-determined (InitElem) or probed
        mid = initial_medium;

        if (mid == MEDIUM_UNKNOWN) {
            float hd;
            int tid;
            bool ff;

            if (trace_ray(p, d, 0.0, FMAX, hd, tid, ff)) {
                uint fm, bm;
                unpack_media(face_normal[tid * 2].w, fm, bm);
                mid = ff ? fm : bm;

                // Source outside the mesh, pointing at it: enter through the hit face
                if (mid == MEDIUM_AMBIENT && ff) {
                    vec3 hp = p + d * hd;
                    p = hp + d * SAFETY_DIST;
                    mid = bm;

                    if (do_reflect > 0u && media[0].n != media[mid].n
                            && do_reflection(get_normal(tid, hp), face_normal[tid * 2].xyz, media[0].n, media[mid].n, rng, hp, p, d)) {
                        mid = MEDIUM_DEAD;
                        w = 0.0;
                    }
                }
            } else {
                mid = MEDIUM_DEAD;
            }
        }
    }
}

// ==================== Trajectory ====================

// Record one trajectory event: photon_id, position, weight, event type.
// event: 0=launch, 1=scatter, 2=terminated
// traj_data[0] is the atomic counter; data starts at index 1 (6 uints per record).
void save_traj(vec3 p, float w, uint photon_id, uint event) {
    if (do_traj == 0u) {
        return;
    }

    uint slot = atomicAdd(traj_data[0], 1u);

    if (slot >= max_traj) {
        return;
    }

    uint base = 1u + slot * 6u;
    traj_data[base]      = photon_id;
    traj_data[base + 1u] = floatBitsToUint(p.x);
    traj_data[base + 2u] = floatBitsToUint(p.y);
    traj_data[base + 3u] = floatBitsToUint(p.z);
    traj_data[base + 4u] = floatBitsToUint(w);
    traj_data[base + 5u] = event;
}

// ==================== Main Loop ====================

void main() {
    uint tid = gl_GlobalInvocationID.x;

    if (tid >= total_threads) {
        return;
    }

    uvec4 rng = thread_seeds[tid];
    int done = 0, maxph = photons_per_thread + int(tid < uint(extra_photons));

    if (maxph <= 0) {
        return;
    }

    vec3 pos, dir;
    float weight, slen, tof;
    uint mid;
    uvec2 mstate;
    uint photon_id = photon_base + tid;  // globally unique across batches

    vec3 launch_pos;
    uvec2 csg_cache = uvec2(0u, 0u);
    bool csg_cached = false;
    launch_photon(pos, dir, weight, slen, tof, mid, mstate, rng, launch_pos, csg_cache, csg_cached);
    save_traj(launch_pos, 1.0, photon_id, 0u);         // save original source position

    if (any(notEqual(launch_pos, pos))) {
        save_traj(pos, weight, photon_id, 3u);          // save sphere-entry boundary
    }

    bool traj_need_term = (mid != MEDIUM_DEAD);

    while (done < maxph) {

        if (mid != MEDIUM_DEAD && mid != MEDIUM_AMBIENT) {
            Medium prop = media[mid];

            bool is_transparent = (prop.mus < FEPS);
            float max_dist = is_transparent ? FMAX : slen / prop.mus;
            float hd;
            int tri;
            bool ff;

            // OPTIMIZATION: always use trace_ray (no barycentrics)
            // Curvature normal is computed from hit_pos, not barycentrics
            bool hit = trace_ray(pos, dir, RAY_TMIN, max_dist, hd, tri, ff);

            // ---- Transparent medium, no hit → photon escapes ----
            if (!hit && is_transparent) {
                mid = MEDIUM_DEAD;

                // ---- Hit a boundary ----
            } else if (hit) {
                uint fm, bm;
                unpack_media(face_normal[tri * 2].w, fm, bm);
                float L = is_transparent ? hd : min(hd, slen / prop.mus);

                // save output
                accumulate(pos, dir, mid, weight, tof, L);

                // update photon position, weight, timer; a crossing photon is
                // placed SAFETY_DIST off the facet plane on the far side
                vec3 hit_pos = pos + dir * L;   /* exact surface hit point for trajectory */
                vec3 Ng = face_normal[tri * 2].xyz;
                pos = hit_pos + ((dot(dir, Ng) > 0.0) ? Ng : -Ng) * SAFETY_DIST;
                weight *= exp(-prop.mua * L);
                tof += L * INV_C0 * prop.n;

                // update remaining scattering length
                if (!is_transparent) {
                    slen -= L * prop.mus;
                }

                // ---- Boundary crossing: determine new medium ----

#ifdef USE_CSG

                if (do_csg > 0u) {
                    // CSG mode: update media state buffer
                    uint old_mid = mid;
                    uvec2 new_ms = ff ? ms_enter(mstate, bm) : ms_leave(mstate, bm);

                    if (is_coplanar_triangle(face_normal[tri * 2].w)) {
                        uvec2 unused0 = uvec2(0u), unused1 = uvec2(0u);
                        new_ms = mstate;
                        coplanar_crossings(pos, (dot(dir, Ng) > 0.0) ? Ng : -Ng, 0, new_ms, unused0, unused1);
                    }

                    uint new_mid = ms_get(new_ms, 0);

                    bool reflected = false;

                    // Check for refractive index mismatch at boundary
                    if (do_reflect > 0u && new_mid != old_mid
                            && new_mid < num_media && old_mid < num_media) {
                        float n_in = media[old_mid].n;
                        float n_out = media[new_mid].n;   // media[0] is the background

                        if (n_in != n_out) {
                            // Only compute curvature normal at actual refractive boundary
                            vec3 N = get_normal(tri, hit_pos);

                            if (!ff) {
                                N = -N;
                            }

                            reflected = do_reflection(N, face_normal[tri * 2].xyz, n_in, n_out, rng, hit_pos, pos, dir);
                        }
                    }

                    if (!reflected) {
                        mstate = new_ms;
                        mid = new_mid;

                        if (mid == 0u) {
                            mid = MEDIUM_DEAD;
                        }
                    }

                    if (new_mid != old_mid) {
                        save_traj(hit_pos, weight, photon_id, reflected ? 4u : 3u);
                        traj_need_term = false;
                    }
                } else
#endif
                {
                    // Mesh mode: new medium from triangle's front/back labels
                    uint old_mid = mid;
                    uint new_mid = ff ? bm : fm;
                    bool reflected = false;

                    // Attempt reflection if crossing a refractive boundary
                    // Allow reflection at medium-to-ambient boundaries (tissue-to-air)
                    if (do_reflect > 0u && mid < num_media) {
                        float n_out = (new_mid < num_media) ? media[new_mid].n : 1.0;

                        if (prop.n != n_out) {
                            vec3 N = get_normal(tri, hit_pos);

                            if (!ff) {
                                N = -N;
                            }

                            reflected = do_reflection(N, face_normal[tri * 2].xyz, prop.n, n_out, rng, hit_pos, pos, dir);
                        }
                    }

                    if (!reflected) {
                        mid = new_mid;

                        if (mid == MEDIUM_AMBIENT) {
                            mid = MEDIUM_DEAD;
                        }
                    }

                    if (new_mid != old_mid) {
                        save_traj(hit_pos, weight, photon_id, reflected ? 4u : 3u);
                        traj_need_term = false;
                    }
                }

                // ---- No hit, not transparent → scattering event ----
            } else if (!hit && !is_transparent) {
#ifdef USE_CSG

                // In CSG mode, if photon is outside all shapes, terminate
                if (do_csg > 0u && ms_get(mstate, 0) == 0u) {
                    mid = MEDIUM_DEAD;
                } else
#endif
                {
                    // Scatter: move to scattering site, update weight, pick new direction
                    float L = slen / prop.mus;
                    accumulate(pos, dir, mid, weight, tof, L);
                    pos += dir * L;
                    weight *= exp(-prop.mua * L);
                    tof += L * INV_C0 * prop.n;

                    // Russian roulette: survivors carry the weight of the terminated photons
                    if (weight < minenergy) {
                        if (rand01(rng) * roulettesize <= 1.0) {
                            weight *= roulettesize;
                        } else {
                            mid = MEDIUM_DEAD;
                        }
                    }

                    if (mid != MEDIUM_DEAD) {
                        dir = scatter_dir(dir, prop.g, rng);
                        slen = rand_scatlen(rng);
                        save_traj(pos, weight, photon_id, 1u);
                        traj_need_term = true;
                    }
                }
            }
        }

        // When a photon escapes or tof reaches the upper limit, launch a new one
        if (mid == MEDIUM_DEAD || mid == MEDIUM_AMBIENT || tof >= time_end) {
            if (traj_need_term) {
                save_traj(pos, weight, photon_id, 2u);
            }

            launch_photon(pos, dir, weight, slen, tof, mid, mstate, rng, launch_pos, csg_cache, csg_cached);
            ++done;
            photon_id = photon_base + total_threads * uint(done) + tid;

            if (done < maxph) {
                save_traj(launch_pos, 1.0, photon_id, 0u);  // original source position

                if (any(notEqual(launch_pos, pos))) {
                    save_traj(pos, weight, photon_id, 3u);   // sphere-entry boundary
                }

                traj_need_term = (mid != MEDIUM_DEAD);
            }
        }
    }
}